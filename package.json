{
  "name": "airport-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "星海国际机场室内导航：HarmonyOS 原工程 + 平台无关共享核心 + Web/小程序/iOS 客户端",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "export": "python3 tools/export_shared.py",
    "test": "node --test packages/core/test/conformance.test.ts packages/core/test/render.test.ts packages/core/test/app-model.test.ts",
    "test:core": "node --test packages/core/test/conformance.test.ts packages/core/test/render.test.ts packages/core/test/app-model.test.ts",
    "check": "npm run export && npm run test",
    "web": "pnpm --filter @airport-guide/web dev",
    "web:build": "pnpm --filter @airport-guide/web build && node tools/build_web_pwa.mjs",
    "test:web": "node tools/web_smoke.mjs",
    "test:all": "npm run test && npm run test:tokens && npm run web:build && npm run test:web && npm run test:apple && npm run test:weapp",
    "test:apple": "bash tools/apple_test.sh test",
    "apple:run": "bash tools/apple_test.sh run airport-cli",
    "apple:build": "bash tools/apple_test.sh build",
    "weapp:build": "node tools/build_weapp.mjs",
    "test:weapp": "node tools/weapp_smoke.mjs && node tools/weapp_static.mjs",
    "fixtures": "node tools/gen_route_fixture.mjs && node tools/gen_render_fixture.mjs",
    "test:tokens": "node tools/check_tokens.mjs",
    "check:weapp": "node tools/weapp_static.mjs",
    "test:pwa": "node tools/build_web_pwa.mjs",
    "check:all": "bash tools/check_all.sh",
    "verify:arkts": "node tools/verify_product.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
