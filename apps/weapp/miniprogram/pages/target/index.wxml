<view class="page">
  <view class="top">
    <view class="pill" bindtap="onBack">‹</view>
    <text class="title">{{title}}</text>
    <view class="spacer"></view>
    <view class="pill" bindtap="onToggleLang">{{langLabel}}</view>
  </view>

  <text class="hint">{{hint}}</text>

  <scroll-view class="chips" scroll-x="true">
    <view class="chip {{item.key === activeCategory ? 'chipOn' : ''}}"
          wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" bindtap="onCategory">{{item.label}}</view>
  </scroll-view>

  <view class="searchRow">
    <input class="search" value="{{query}}" placeholder="{{searchHint}}" bindinput="onSearchInput" confirm-type="search" />
    <view class="clear" wx:if="{{query.length > 0}}" bindtap="onClear">{{clearLabel}}</view>
  </view>

  <view class="empty" wx:if="{{empty}}">
    <text class="emptyTitle">{{noResults}}</text>
    <text class="emptySub">{{noResultsHint}}</text>
  </view>

  <view class="row" wx:for="{{places}}" wx:key="id" data-id="{{item.id}}" bindtap="onPick">
    <view class="dot"></view>
    <view class="rowMain">
      <text class="rowTitle">{{item.title}}</text>
      <text class="rowSub">{{item.subtitle}}</text>
    </view>
    <text class="arrow">›</text>
  </view>
</view>
