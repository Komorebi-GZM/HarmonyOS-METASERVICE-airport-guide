<view class="page">
  <view class="top">
    <text class="brand">{{brand}}</text>
    <view class="spacer"></view>
    <view class="pill" bindtap="onToggleLang">{{langLabel}}</view>
  </view>

  <text class="hero">{{heroTitle}}</text>
  <text class="heroSub">{{heroSub}}</text>

  <view class="card primary" bindtap="onGoGate">
    <text class="ico">✈</text>
    <text class="cardText">{{goGate}}</text>
  </view>
  <view class="card" bindtap="onGoMetro">
    <text class="ico">◆</text>
    <text class="cardText">{{goMetro}}</text>
  </view>
  <view class="card" bindtap="onGoService">
    <text class="ico">☕</text>
    <text class="cardText">{{goService}}</text>
  </view>

  <text class="section">{{popularTitle}}</text>
  <view class="grid">
    <view class="quick" wx:for="{{popular}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickPopular">
      <text class="quickTitle">{{item.title}}</text>
      <text class="quickSub">{{item.subtitle}}</text>
    </view>
  </view>

  <block wx:if="{{recent.length > 0}}">
    <text class="section">{{recentTitle}}</text>
    <view class="row" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickPopular">
      <view class="dot"></view>
      <view class="rowMain">
        <text class="rowTitle">{{item.title}}</text>
        <text class="rowSub">{{item.subtitle}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </block>

  <view class="actions">
    <view class="btn" bindtap="onOpenFloors">{{floorsLabel}}</view>
    <view class="btn" bindtap="onOpenMapPicker">{{mapLabel}}</view>
  </view>

  <text class="footnote">{{sample}}</text>
</view>
