<view class="page">
  <view class="top">
    <view class="pill" bindtap="onBack">‹</view>
    <text class="title">{{title}}</text>
    <view class="spacer"></view>
    <view class="pill" bindtap="onToggleLang">{{langLabel}}</view>
  </view>

  <view class="selected" wx:if="{{selectedName}}">
    <text class="selectedLabel">{{selectedLabel}}</text>
    <text class="selectedName">{{selectedName}}</text>
  </view>

  <text class="hint">{{hint}}</text>

  <text class="section">{{quickTitle}}</text>
  <view class="grid">
    <view class="quick" wx:for="{{quick}}" wx:key="id" data-id="{{item.id}}" bindtap="onQuick">
      <text class="quickTitle">{{item.title}}</text>
      <text class="quickSub">{{item.subtitle}}</text>
    </view>
  </view>

  <text class="section">{{searchHint}}</text>
  <view class="row" wx:for="{{places}}" wx:key="id" data-id="{{item.id}}" bindtap="onPick">
    <view class="dot"></view>
    <view class="rowMain">
      <text class="rowTitle">{{item.title}}</text>
      <text class="rowSub">{{item.subtitle}}</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="actions">
    <view class="btn" bindtap="onOpenMapPicker">{{mapLabel}}</view>
  </view>
</view>
