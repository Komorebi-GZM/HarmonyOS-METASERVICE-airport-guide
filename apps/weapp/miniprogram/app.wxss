@import './tokens.wxss';

/* 全局样式：令牌对齐 docs/DESIGN.md 与 Theme.ets（经 export_shared.py 导出）。
   小程序用 rpx（750rpx = 屏宽），尺寸按"视觉近似"落地。 */

page {
  /* 语义别名：与 apps/web/src/styles.css 的 :root 保持一致（两端观感必须一样） */
  --bg: var(--app-bg);
  --card: var(--app-card);
  --card2: var(--app-card2);
  --line: var(--app-line);
  --text: var(--app-text);
  --sub: var(--app-sub);
  --accent: var(--app-accent);
  --accent-soft: var(--app-accent-soft);
  --gold: var(--app-gold);
  --gtext: var(--app-gtext);
  --on-accent: #FFFFFF;        /* 强调色上的文字 */
  --warn-bg: #FFF2DF;          /* 提示底色（ArkTS 里也是硬编码，见 docs/TODO.md T-203） */

  background: var(--bg);
  color: var(--text);
  font-size: var(--font-15);
}

.page {
  padding: 24rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* ---------------------------------------------------------------- 顶栏 */
.top {
  display: flex;
  align-items: center;
  padding: var(--space-8) 0 var(--space-4);
}
.brand { font-size: var(--font-15); font-weight: 700; color: var(--accent); }
.title { font-size: var(--font-19); font-weight: 700; }
.spacer { flex: 1; }
.pill {
  min-width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: var(--radius-pill);
  background: var(--card);
  border: 1rpx solid var(--line);
  font-size: var(--font-14);
  color: var(--accent);
}

/* ---------------------------------------------------------------- 首页 */
.hero { font-size: var(--font-28); font-weight: 700; margin-top: var(--space-4); }
.heroSub { font-size: var(--font-14); color: var(--sub); margin-top: 4rpx; }

.card {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: var(--space-12) var(--space-14);
  margin-top: var(--space-10);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
}
.card.primary { background: var(--accent); border-color: var(--accent); }
.card.primary .cardText, .card.primary .cardSub { color: var(--card); }
.ico {
  width: 68rpx; height: 68rpx; line-height: 68rpx; text-align: center;
  border-radius: var(--radius-11); background: var(--accent-soft); color: var(--accent); margin-right: var(--space-12);
}
.card.primary .ico { background: rgba(255, 255, 255, 0.2); color: var(--card); }
.cardStack { display: flex; flex-direction: column; }
.cardText { font-size: var(--font-17); font-weight: 600; }
.cardSub { font-size: var(--font-13); color: var(--sub); }

.section { font-size: var(--font-14); font-weight: 700; color: var(--sub); margin: var(--space-14) 0 var(--space-6); }

.grid { display: flex; flex-wrap: wrap; margin: -var(--space-4); }
.quick {
  width: 50%;
  box-sizing: border-box;
  padding: var(--space-4);
}
.quickTitle { display: block; font-size: var(--font-15); font-weight: 600; }
.quickSub { display: block; font-size: var(--font-12); color: var(--sub); }
.quick > .quickTitle, .quick > .quickSub {
  background: var(--card);
  border-left: 1rpx solid var(--line);
  border-right: 1rpx solid var(--line);
  padding: 0 var(--space-10);
}
.quick > .quickTitle { border-top: 1rpx solid var(--line); border-radius: 28rpx 28rpx 0 0; padding-top: var(--space-10); }
.quick > .quickSub { border-bottom: 1rpx solid var(--line); border-radius: 0 0 28rpx 28rpx; padding-bottom: var(--space-10); }

/* ---------------------------------------------------------------- 列表 */
.row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  padding: 18rpx 28rpx;
  margin-top: var(--space-8);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-14);
}
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--accent-soft); margin-right: var(--space-10); }
.rowMain { flex: 1; display: flex; flex-direction: column; }
.rowTitle { font-size: var(--font-15); font-weight: 600; }
.rowSub { font-size: var(--font-12); color: var(--sub); }
.arrow { color: var(--sub); font-size: var(--font-18); }

.actions { display: flex; margin-top: var(--space-10); }
.btn {
  flex: 1;
  min-height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  margin-right: var(--space-8);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-14);
  font-size: var(--font-15);
  font-weight: 600;
}
.btn:last-child { margin-right: 0; }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--card); }
.btn.disabled { opacity: 0.45; }
.footnote { font-size: var(--font-12); color: var(--sub); margin-top: var(--space-10); }
.hint { font-size: var(--font-13); color: var(--sub); margin-top: var(--space-4); }

/* ---------------------------------------------------------------- 选择器 */
.chips { white-space: nowrap; margin-top: var(--space-8); }
.chip {
  display: inline-block;
  padding: var(--space-6) var(--space-14);
  margin-right: var(--space-8);
  border-radius: var(--radius-pill);
  background: var(--card);
  border: 1rpx solid var(--line);
  color: var(--sub);
  font-size: var(--font-13);
  font-weight: 600;
}
.chipOn { background: var(--accent); border-color: var(--accent); color: var(--card); }

.searchRow { display: flex; align-items: center; margin-top: var(--space-8); }
.search {
  flex: 1;
  min-height: 96rpx;
  padding: 0 var(--space-16);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-pill);
  font-size: var(--font-14);
}
.clear { padding-left: var(--space-10); color: var(--accent); font-size: var(--font-13); }

.empty { padding: 60rpx 0; text-align: center; }
.emptyTitle { display: block; font-size: var(--font-17); font-weight: 600; }
.emptySub { display: block; font-size: var(--font-13); color: var(--sub); margin-top: var(--space-4); }

.selected {
  display: flex;
  align-items: center;
  padding: var(--space-10) var(--space-14);
  margin-top: var(--space-8);
  background: var(--accent-soft);
  border-radius: var(--radius-14);
}
.selectedLabel { font-size: var(--font-12); font-weight: 700; color: var(--gtext); margin-right: var(--space-6); }
.selectedName { font-size: var(--font-15); font-weight: 700; }

/* ---------------------------------------------------------------- 路线 */
.summary {
  padding: var(--space-14) var(--space-16);
  margin-top: var(--space-8);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
}
.summaryLine { display: flex; align-items: center; font-size: var(--font-15); font-weight: 600; margin-bottom: var(--space-4); }
.dotStart { width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--accent); margin-right: var(--space-8); }
.dotEnd { width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--gold); margin-right: var(--space-8); }
.summaryMeta { display: block; font-size: var(--font-13); color: var(--sub); }
.badge {
  display: inline-block;
  margin-top: var(--space-6);
  padding: var(--space-4) var(--space-10);
  border-radius: var(--radius-pill);
  background: var(--accent-soft);
  color: var(--accent);
  font-size: var(--font-12);
  font-weight: 700;
}
.badgeWarn { background: var(--warn-bg); color: var(--gtext); }

.mapBox {
  position: relative;
  height: 600rpx;
  margin-top: var(--space-10);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  overflow: hidden;
  background: var(--map-surface);
}
.mapBox.tall { height: 700rpx; }
.mapCanvas { width: 100%; height: 100%; }
.mapTools { position: absolute; right: 20rpx; bottom: 20rpx; display: flex; }
.tool {
  width: 68rpx; height: 68rpx; line-height: 68rpx; text-align: center;
  margin-left: var(--space-6);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid var(--line);
  font-size: var(--font-15);
}

.stepCard {
  padding: var(--space-14) var(--space-16);
  margin-top: var(--space-10);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
}
.stepHead { display: flex; justify-content: space-between; font-size: var(--font-12); color: var(--sub); }
.stepIndex { color: var(--accent); font-weight: 600; }
.stepTitle { display: block; font-size: var(--font-19); font-weight: 700; margin-top: var(--space-4); }
.stepMeters { display: block; font-size: var(--font-14); color: var(--accent); font-weight: 600; }
.stepHint { display: block; font-size: var(--font-12); color: var(--sub); }

.steps {
  margin-top: var(--space-10);
  padding: var(--space-10) var(--space-14);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
}
.stepRow { padding: 10rpx 0; font-size: var(--font-14); color: var(--sub); }
.stepOn { color: var(--text); font-weight: 700; }
.stepNo { color: var(--accent); font-weight: 600; margin-right: var(--space-6); }
.stepText { font-size: var(--font-14); color: var(--sub); }

/* ---------------------------------------------------------------- 详情 */
.detail {
  padding: var(--space-14) var(--space-16);
  margin-top: var(--space-10);
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
}
.detailName { display: block; font-size: var(--font-17); font-weight: 700; }
.detailSub { display: block; font-size: var(--font-13); color: var(--sub); margin-bottom: var(--space-6); }
